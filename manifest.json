{
  "manifest_version": 3,
  "name": "粉丝透镜 Follower Lens",
  "version": "0.1.3",
  "description": "在 X 的信息流和关注列表里显示粉丝数,并给出粉丝/关注比、账号年龄、互动率等质量标签。",
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "parse.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}